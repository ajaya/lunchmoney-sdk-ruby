#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path('..', __dir__)
if File.file?(File.join(root, 'Gemfile'))
  ENV['BUNDLE_GEMFILE'] ||= File.join(root, 'Gemfile')
  require 'bundler'
  Bundler.ui.silence { Bundler.setup }
end
$LOAD_PATH.unshift(File.join(root, 'lib'))
require 'optparse'

options = { http: false, port: 9294 }
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: lunchmoney-mcp [--http] [--port PORT]'
  opts.on('--http', 'Serve Streamable HTTP at http://127.0.0.1:9294/mcp') { options[:http] = true }
  opts.on('--port PORT', Integer, 'HTTP port (default: 9294)') { |port| options[:port] = port }
  opts.on('-h', '--help', 'Show help') { puts opts; exit }
end

begin
  parser.parse!
  raise OptionParser::InvalidArgument, ARGV.join(' ') unless ARGV.empty?
  raise OptionParser::InvalidArgument, 'port must be between 1 and 65535' unless (1..65_535).cover?(options[:port])

  require 'lunchmoney-sdk-ruby/mcp_server'
  LunchMoney::MCPServer.run(**options)
rescue LoadError
  warn 'MCP dependencies are missing. Run bundle install in the checkout, or gem install mcp rackup webrick.'
  exit 1
rescue OptionParser::ParseError, KeyError, ArgumentError => error
  warn error.message
  exit 1
end
